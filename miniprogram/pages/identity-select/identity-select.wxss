page {
  background: #f6f8fb;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 54rpx;
}

.page-head {
  padding: 12rpx 4rpx 28rpx;
}

.page-title {
  color: #111827;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.25;
}

.page-desc,
.option-desc,
.state-desc {
  color: #667085;
  font-size: 26rpx;
  line-height: 1.5;
}

.page-desc {
  margin-top: 10rpx;
}

.option-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option-card,
.state-card {
  padding: 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid #e7ecf3;
  box-shadow: 0 12rpx 34rpx rgba(15, 23, 42, 0.055);
}

.option-title,
.state-title {
  color: #111827;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.3;
}

.option-desc,
.state-desc {
  margin-top: 10rpx;
}

.state-card {
  padding-top: 68rpx;
  padding-bottom: 68rpx;
  text-align: center;
}

.primary-button,
.secondary-button {
  margin-top: 28rpx;
  height: 82rpx;
  border-radius: 16rpx;
  font-size: 29rpx;
  font-weight: 800;
}

.primary-button {
  background: #0052d9;
  color: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(0, 82, 217, 0.18);
}

.secondary-button {
  background: #edf3ff;
  color: #0052d9;
}

.button-pressed {
  transform: scale(0.98);
  opacity: 0.9;
}
