page {
  background: #f6f8fb;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 54rpx;
}

.access-card {
  padding: 34rpx 30rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid #e7ecf3;
  box-shadow: 0 12rpx 34rpx rgba(15, 23, 42, 0.055);
}

.page-title {
  color: #111827;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.25;
}

.page-desc {
  margin-top: 12rpx;
  color: #667085;
  font-size: 26rpx;
  line-height: 1.5;
}

.field {
  margin-top: 30rpx;
}

.field-label {
  margin-bottom: 12rpx;
  color: #1f2937;
  font-size: 26rpx;
  font-weight: 700;
}

.form-input {
  width: 100%;
  height: 82rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  border: 1rpx solid #dbe7f3;
  color: #111827;
  font-size: 28rpx;
  line-height: 82rpx;
}

.input-placeholder {
  color: #94a3b8;
  font-size: 27rpx;
}

.error-message {
  margin-top: 24rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #fff5f5;
  border: 1rpx solid #fecaca;
  color: #991b1b;
  font-size: 25rpx;
  line-height: 1.45;
}

.submit-button {
  margin-top: 36rpx;
  height: 86rpx;
  border-radius: 16rpx;
  background: #0052d9;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 22rpx rgba(0, 82, 217, 0.18);
}

.submit-button[disabled] {
  background: #93c5fd;
  color: #ffffff;
}
